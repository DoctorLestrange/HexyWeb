    "type": "git",
    "url": "https://github.com/DoctorLestrange/HexyWeb.git"
  },
  "bugs": {
    "url": "https://github.com/DoctorLestrange/HexyWeb/issues"
  },
  "keywords": [
    "hash",
    "checksum",
